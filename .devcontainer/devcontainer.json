{
  "name": "WD2 Svelte",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [
    5173,
    4173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Svelte development",
      "onAutoForward": "notify"
    },
    "4173": {
      "label": "Production preview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode"
      ]
    }
  }
}
